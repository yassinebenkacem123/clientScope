generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  MANAGER
  CONTRIBUTOR
  CLIENT_ADMIN
  CLIENT_VIEWER
}

enum ProjectStatus {
  DRAFT
  ONBOARDING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum TicketStatus {
  SUBMITTED
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum ScopeStatus {
  PENDING_REVIEW
  INCLUDED
  EXTRA_PAID
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum Decision {
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum VersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUPERSEDED
}

enum ChangeStatus {
  REQUESTED
  REVIEWING
  QUOTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ActionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum JobStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ExportStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  authUserId             String?                 @unique @db.Uuid // Supabase Auth UUID; populated on first authenticated request
  email                  String                  @unique
  fullName               String?
  avatarUrl              String?
  createdAt              DateTime                @default(now())
  ownedWorkspaces        Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships   WorkspaceMember[]
  clientContacts         ClientContact[]
  projectMemberships     ProjectMember[]
  sentInvitations        ProjectInvitation[]     @relation("InvitationSender")
  submissions            OnboardingSubmission[]
  createdTickets         Ticket[]                @relation("TicketCreator")
  assignedTickets        Ticket[]                @relation("TicketAssignee")
  ticketComments         TicketComment[]
  actionItems            ClientActionItem[]
  organizedMeetings      Meeting[]
  meetingAttendance      MeetingAttendee[]
  meetingNotes           MeetingNote[]
  uploads                File[]
  changeRequests         ChangeRequest[]
  approvals              Approval[]
  deliverables           Deliverable[]
  reviews                DeliverableReview[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  reminders              Reminder[]
  auditEvents            AuditEvent[]
  exports                Export[]
}

model Workspace {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  slug      String               @unique
  ownerId   String               @db.Uuid
  owner     User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime             @default(now())
  members   WorkspaceMember[]
  branding  WorkspaceBranding?
  clients   Client[]
  projects  Project[]
  templates OnboardingTemplate[]
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceBranding {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @unique @db.Uuid
  logoStorageKey String?
  primaryColor   String?
  portalTitle    String?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Client {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  businessName String
  industry     String?
  status       String          @default("active")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts     ClientContact[]
  projects     Project[]

  @@index([workspaceId])
}

model ClientContact {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  userId   String @db.Uuid
  role     String @default("contact")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])

  @@unique([clientId, userId])
}

model Project {
  id            String              @id @default(uuid()) @db.Uuid
  workspaceId   String              @db.Uuid
  clientId      String              @db.Uuid
  name          String
  description   String?
  status        ProjectStatus       @default(DRAFT)
  currency      String              @default("USD") @db.VarChar(3)
  startDate     DateTime?           @db.Date
  targetDate    DateTime?           @db.Date
  createdAt     DateTime            @default(now())
  workspace     Workspace           @relation(fields: [workspaceId], references: [id])
  client        Client              @relation(fields: [clientId], references: [id])
  members       ProjectMember[]
  invitations   ProjectInvitation[]
  forms         OnboardingForm[]
  pages         ProjectPage[]
  tickets       Ticket[]
  actionItems   ClientActionItem[]
  meetings      Meeting[]
  files         File[]
  scopes        ScopeVersion[]
  changes       ChangeRequest[]
  quotes        Quote[]
  deliverables  Deliverable[]
  notifications Notification[]
  reminders     Reminder[]
  auditEvents   AuditEvent[]
  exports       Export[]

  @@index([workspaceId, status])
  @@index([clientId])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(CLIENT_VIEWER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model ProjectInvitation {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @db.Uuid
  invitedById String      @db.Uuid
  email       String
  tokenHash   String      @unique
  role        ProjectRole @default(CLIENT_VIEWER)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([projectId, email])
}

model OnboardingTemplate {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  name        String
  category    String?
  definition  Json
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  forms       OnboardingForm[]
}

model OnboardingForm {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  templateId         String?                @db.Uuid
  title              String
  status             FormStatus             @default(DRAFT)
  definitionSnapshot Json
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template           OnboardingTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  submissions        OnboardingSubmission[]
}

model OnboardingSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  formId        String           @db.Uuid
  submittedById String           @db.Uuid
  status        SubmissionStatus @default(DRAFT)
  submittedAt   DateTime?
  form          OnboardingForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy   User             @relation(fields: [submittedById], references: [id])
  answers       FormAnswer[]
}

model FormAnswer {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @db.Uuid
  fieldKey     String
  answerValue  Json
  submission   OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldKey])
}

model ProjectPage {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  name      String
  slug      String
  position  Int           @default(0)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections  PageSection[]

  @@unique([projectId, slug])
}

model PageSection {
  id          String      @id @default(uuid()) @db.Uuid
  pageId      String      @db.Uuid
  sectionType String
  content     Json
  position    Int         @default(0)
  page        ProjectPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  parentTicketId String?         @db.Uuid
  createdById    String          @db.Uuid
  assignedToId   String?         @db.Uuid
  title          String
  description    String?
  type           String          @default("feature")
  status         TicketStatus    @default(SUBMITTED)
  scopeStatus    ScopeStatus     @default(PENDING_REVIEW)
  priority       Priority        @default(MEDIUM)
  clientVisible  Boolean         @default(true)
  dueDate        DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTicket   Ticket?         @relation("TicketTree", fields: [parentTicketId], references: [id])
  childTickets   Ticket[]        @relation("TicketTree")
  createdBy      User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo     User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  comments       TicketComment[]
  scopeItems     ScopeItem[]
  changeRequests ChangeRequest[]

  @@index([projectId, status])
}

model TicketComment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  authorId     String   @db.Uuid
  content      String
  internalOnly Boolean  @default(false)
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id])
}

model ClientActionItem {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  assignedToId String?      @db.Uuid
  title        String
  description  String?
  status       ActionStatus @default(OPEN)
  dueAt        DateTime?
  completedAt  DateTime?
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id])
}

model Meeting {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  organizerId String            @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  timezone    String            @default("UTC")
  status      MeetingStatus     @default(REQUESTED)
  meetingUrl  String?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer   User              @relation(fields: [organizerId], references: [id])
  attendees   MeetingAttendee[]
  notes       MeetingNote[]
}

model MeetingAttendee {
  id             String  @id @default(uuid()) @db.Uuid
  meetingId      String  @db.Uuid
  userId         String  @db.Uuid
  responseStatus String  @default("pending")
  meeting        Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user           User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model MeetingNote {
  id        String  @id @default(uuid()) @db.Uuid
  meetingId String  @db.Uuid
  authorId  String  @db.Uuid
  content   String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author    User    @relation(fields: [authorId], references: [id])
}

model File {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  uploadedById String           @db.Uuid
  storageKey   String           @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime         @default(now())
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  attachments  FileAttachment[]
}

model FileAttachment {
  id         String @id @default(uuid()) @db.Uuid
  fileId     String @db.Uuid
  targetType String
  targetId   String @db.Uuid
  file       File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

model ScopeVersion {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  versionNumber Int
  status        VersionStatus @default(DRAFT)
  agreedTotal   Decimal?      @db.Decimal(12, 2)
  currency      String        @db.VarChar(3)
  approvedAt    DateTime?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         ScopeItem[]
  approvals     Approval[]

  @@unique([projectId, versionNumber])
}

model ScopeItem {
  id             String       @id @default(uuid()) @db.Uuid
  scopeVersionId String       @db.Uuid
  ticketId       String?      @db.Uuid
  title          String
  description    String?
  position       Int          @default(0)
  scopeVersion   ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id])
}

model ChangeRequest {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @db.Uuid
  ticketId      String?      @db.Uuid
  requestedById String       @db.Uuid
  description   String
  status        ChangeStatus @default(REQUESTED)
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket        Ticket?      @relation(fields: [ticketId], references: [id])
  requestedBy   User         @relation(fields: [requestedById], references: [id])
  quotes        Quote[]
}

model Quote {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  changeRequestId String?        @db.Uuid
  revisionNumber  Int            @default(1)
  status          QuoteStatus    @default(DRAFT)
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @db.VarChar(3)
  validUntil      DateTime?
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  items           QuoteItem[]
  approvals       Approval[]

  @@index([projectId, status])
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Approval {
  id             String        @id @default(uuid()) @db.Uuid
  approverId     String        @db.Uuid
  quoteId        String?       @db.Uuid
  scopeVersionId String?       @db.Uuid
  decision       Decision
  comment        String?
  decidedAt      DateTime      @default(now())
  approver       User          @relation(fields: [approverId], references: [id])
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  scopeVersion   ScopeVersion? @relation(fields: [scopeVersionId], references: [id])
}

model Deliverable {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  createdById    String              @db.Uuid
  title          String
  description    String?
  status         DeliverableStatus   @default(DRAFT)
  revisionNumber Int                 @default(1)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                @relation(fields: [createdById], references: [id])
  reviews        DeliverableReview[]
}

model DeliverableReview {
  id            String      @id @default(uuid()) @db.Uuid
  deliverableId String      @db.Uuid
  reviewerId    String      @db.Uuid
  decision      Decision
  feedback      String?
  reviewedAt    DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewer      User        @relation(fields: [reviewerId], references: [id])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  projectId String?   @db.Uuid
  type      String
  title     String
  message   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
}

model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @db.Uuid
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  recipientId  String    @db.Uuid
  targetType   String
  targetId     String    @db.Uuid
  scheduledAt  DateTime
  status       JobStatus @default(PENDING)
  attemptCount Int       @default(0)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient    User      @relation(fields: [recipientId], references: [id])

  @@index([status, scheduledAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String?  @db.Uuid
  eventType  String
  entityType String
  entityId   String   @db.Uuid
  details    Json
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([projectId, createdAt])
}

model Export {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @db.Uuid
  generatedById String       @db.Uuid
  exportType    String
  status        ExportStatus @default(PENDING)
  storageKey    String?
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedBy   User         @relation(fields: [generatedById], references: [id])
}
